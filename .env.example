# Local development only. Replace these placeholders before exposing services.
# Never commit real credentials. Compose reads these values for the local DB.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH0_DOMAIN=your-tenant.example.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-spa-client-id
VITE_AUTH0_AUDIENCE=https://opsdesk.example/api
POSTGRES_DB=opsdesk
POSTGRES_USER=opsdesk
POSTGRES_PASSWORD=opsdesk
OPSDESK_DB_PORT=5432
OPSDESK_DATABASE_URL=postgresql+psycopg://opsdesk:opsdesk@localhost:5432/opsdesk
OPSDESK_OIDC_ISSUER=https://your-tenant.example.auth0.com/
OPSDESK_OIDC_AUDIENCE=https://opsdesk.example/api
# Optional; by default the API uses {issuer}/.well-known/jwks.json.
OPSDESK_OIDC_JWKS_URL=
OPSDESK_CORS_ORIGINS=http://localhost:5173
